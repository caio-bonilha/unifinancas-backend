# Copie este arquivo para .env e ajuste se necessário.
# .env é usado apenas pelo Docker Compose local (Seção 16.1 do SAD) — nunca versionar o .env real.
POSTGRES_DB=unifinancas
POSTGRES_USER=unifinancas
POSTGRES_PASSWORD=unifinancas
POSTGRES_PORT=5432

# --- MinIO (storage S3 local, docker-compose.yml) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Nome do bucket dos documentos; precisa bater com o do backend (unifinancas.storage.s3.bucket).
STORAGE_S3_BUCKET=unifinancas-documentos

# --- Backend apontando para o MinIO local ---
# Jeito simples: rodar o backend com o profile `local`, que já traz esses
# valores (src/main/resources/application-local.yml):
#   PowerShell:  $env:SPRING_PROFILES_ACTIVE = "local"; ./mvnw spring-boot:run
#   bash:        SPRING_PROFILES_ACTIVE=local ./mvnw spring-boot:run
# Só defina as vars abaixo se quiser sobrescrever o profile (não são lidas
# pelo Compose — valem para o processo do backend / run config da IDE).
STORAGE_S3_ENDPOINT_OVERRIDE=http://localhost:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
